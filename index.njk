<!doctype html>
<html>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Soundory</title>

  <link rel="stylesheet" href="reset.css" />
  <link rel="stylesheet" href="style.css" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>

<body>

<!-- ================= NAVBAR ================= -->
<div class="navbar">

  <div class="logo">
    <a href="index.html">
      <img src="images/logo.png">
      Soundory
    </a>
  </div>

  <div class="sections">

    <h2><a href="pages/guitar.html">Guitars</a></h2>
    <h2><a href="pages/bass.html">Basses</a></h2>
    <h2><a href="#">Drums</a></h2>
    <h2><a href="pages/piano.html">Piano</a></h2>

    <div class="search-box">
      <input type="text" class="search_bar" placeholder="Search..">
      <button>Search</button>
    </div>

  </div>

</div>

<!-- ================= MOBILE BANNER ================= -->
<div class="mobile-banner">
  🎵 Mobile Exclusive Deals Available!
</div>

<!-- ================= SLIDER ================= -->
<section class="container">

  <div id="mainCarousel" class="carousel slide" data-bs-ride="carousel">

    <div class="carousel-indicators">
      <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="0" class="active"></button>
      <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="1"></button>
      <button type="button" data-bs-target="#mainCarousel" data-bs-slide-to="2"></button>
    </div>

    <div class="carousel-inner">

      <div class="carousel-item active">
        <img src="images/sale.png" class="d-block w-100 carousel-img">
      </div>

      <div class="carousel-item">
        <img src="images/s3.jpg" class="d-block w-100 carousel-img">
      </div>

      <div class="carousel-item">
        <img src="images/new.jpg" class="d-block w-100 carousel-img">
      </div>

    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#mainCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#mainCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon"></span>
    </button>

  </div>

  <div class="cta_button">
    <button>Order Now</button>
  </div>

</section>

<!-- ================= PRODUCTS ================= -->
<div class="headings">

  <!-- ================= RECENT ================= -->
  <h2>Recently Added</h2>

  <div class="container">
    <div class="row g-4 justify-content-center">

      {% for product in products.recent %}
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="product">
          <img src="{{ product.image }}">
          <p><b>{{ product.brand }}</b> {{ product.title }}</p>
          <div class="price">{{ product.price }}</div>
          <button>Add to cart</button>
        </div>
      </div>
      {% endfor %}

    </div>
  </div>

  <!-- ================= TOP ================= -->
  <h2>Top Sellers</h2>

  <div class="container">
    <div class="row g-4 justify-content-center">

      {% for product in products.top %}
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="product">
          <img src="{{ product.image }}">
          <p><b>{{ product.brand }}</b> {{ product.title }}</p>
          <div class="price">{{ product.price }}</div>
          <button>Add to cart</button>
        </div>
      </div>
      {% endfor %}

    </div>
  </div>

  <!-- ================= SPECIALS ================= -->
  <h2>Specials</h2>

  <div class="container">
    <div class="row g-4 justify-content-center">

      {% for product in products.specials %}
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="product">
          <img src="{{ product.image }}">
          <p><b>{{ product.brand }}</b> {{ product.title }}</p>
          <div class="price">{{ product.price }}</div>
          <button>Add to cart</button>
        </div>
      </div>
      {% endfor %}

    </div>
  </div>

  <!-- ================= LIMITED ================= -->
  <h2>Limited Edition</h2>

  <div class="container">
    <div class="row g-4 justify-content-center">

      {% for product in products.limited %}
      <div class="col-12 col-sm-6 col-lg-3">
        <div class="product">
          <img src="{{ product.image }}">
          <p><b>{{ product.brand }}</b> {{ product.title }}</p>
          <div class="price">{{ product.price }}</div>
          <button>Add to cart</button>
        </div>
      </div>
      {% endfor %}

    </div>
  </div>

</div>

<!-- ================= MASCOT ================= -->
<div class="mascot">
  <img src="images/mascot.png">
  <div class="mascot-message">
    🎸 Welcome to Soundory! Check our latest deals!
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>